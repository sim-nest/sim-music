(music/rewrite-catalog :alphabet '((scale/c variable) (scale/g variable) (scale/d variable)) :axiom '(scale/c) :productions '((c-to-dominants :predecessor scale/c :context () :successor (scale/g scale/d)) (g-to-d :predecessor scale/g :context () :successor (scale/d)) (d-to-c :predecessor scale/d :context () :successor (scale/c))) :scale-states '((scale/c :scale (c major) :pitch-map (scale nearest)) (scale/g :scale (g major) :pitch-map (scale nearest)) (scale/d :scale (d major) :pitch-map (scale nearest))) :expansion '(:generations 2 :symbols-per-generation 4 :total-symbols 8) :search '(:order depth-first :seed 30 :work 100000 :results 16 :frontier 256 :memory-nodes 512) :progression-tree '(:preorder-child-counts (2 0 1 0) :catalog (I IV V) :rank mixed-radix :filter no-repeated-preorder-value) :return '(derivation-tree derivation-receipt ranked-trees search-receipt pitch-maps))
