  (primary [row Route(RouteRecord { id: RouteId("route/analyze-tonnetz-path"), title: "Find a bounded neo-Riemannian path between canonical chords", audiences: ["user", "code", "framework"], steps: [Feature { id: FeatureId("feature/sim-music/pitch-and-sound-vocabulary"), why: "The pitch-set owner supplies canonical masks and typed set relations; the chord owner supplies rooted chord identity; the existing Riemann namer supplies projection-only labels." }, Feature { id: FeatureId("feature/sim-music/exact-music-analysis-and-transform"), why: "Music analysis applies enabled P/L/R generators over canonical major/minor identities and delegates deterministic shortest-path certificates to sim-lib-discrete-graph." }, Specimen { id: SpecimenId("recipe/sim-music/crates/sim-lib-music-analysis/01-basics/tonnetz-path"), why: "The checked descriptor gives the concrete C-major to A-minor call, explicit move set and bound, identity policy, one-edge R result, and reusable certificate contract." }], doc_anchor: None })] [note "route/analyze-tonnetz-path"] [section "route"])
  (primary [row Route(RouteRecord { id: RouteId("route/analyze-twelve-tone-row"), title: "Validate, transform, and inspect a twelve-tone row without losing aliases or label conventions", audiences: ["user", "code", "framework"], steps: [Feature { id: FeatureId("feature/sim-music/pitch-and-sound-vocabulary"), why: "The pitch vocabulary supplies the canonical PitchClass identity; unordered PitchClassMask and pitch-set analysis stay in their existing owners." }, Feature { id: FeatureId("feature/sim-music/serial-series-calculus"), why: "The generic serial layer supplies stable finite alphabet identity and exhaustive exactly-once aggregate validation without assuming pitch." }, Feature { id: FeatureId("feature/sim-music/twelve-tone-row-theory"), why: "The pitch-serial layer owns strict ToneRow values, total normalized P/I/R/RI operations, alias-preserving RowFamilySet values, convention-explicit RowMatrix data and ASCII projection, operation-bearing RowForm values, explicit label conventions, and the narrow pitch/ToneRow Shape adapter." }, Specimen { id: SpecimenId("recipe/sim-music/crates/sim-lib-pitch-serial/01-basics/row-family-matrix"), why: "The checked Rust scenario proves all 48 Op. 25 aliases against their operations, retains symmetry aliases across distinct-form reduction, and projects one source-and-convention-bearing matrix to structured coordinates and ASCII." }], doc_anchor: None })] [note "route/analyze-twelve-tone-row"] [section "route"])
  (primary [row Route(RouteRecord { id: RouteId("route/audify-measured-series"), title: "Hear and creatively transform measured evidence without category fraud or route lock-in", audiences: ["user", "code", "framework"], steps: [Feature { id: FeatureId("feature/sim-music/daw-session-runtime"), why: "The session owner records reversible or explicitly lossy audification, disjoint artistic-mapping provenance, stable content identity, and append-only route substitutions." }, Feature { id: FeatureId("feature/sim-music/audio-lift-and-render"), why: "The audio owner supplies bounded analysis and deterministic rendering without owning scientific meaning." }, Specimen { id: SpecimenId("spec-test/sim-music/crates/sim-lib-daw-session/src/listening"), why: "The listening specimens prove route churn leaves musical and expedition identity stable, mapping families cannot decode as one another, all named target substitutions are typed, and unsupported targets retain exact evidence." }], doc_anchor: None })] [note "route/audify-measured-series"] [section "route"])
  (primary [row Route(RouteRecord { id: RouteId("route/build-music-performance"), title: "Build a music performance", audiences: ["user", "code", "framework"], steps: [Feature { id: FeatureId("feature/sim-music/pitch-and-sound-vocabulary"), why: "The vocabulary row supplies pitch and sound descriptors." }, Feature { id: FeatureId("feature/sim-music/midi-notation-workflows"), why: "The MIDI row moves material into and out of performance formats." }, Feature { id: FeatureId("feature/sim-music/exact-music-analysis-and-transform"), why: "The exact music row owns reusable music objects, analysis descriptors, and sequence transforms." }, Feature { id: FeatureId("feature/sim-music/algorithm-foundry"), why: "The foundry row composes the complete performance plan without baking stage providers into the application." }, Feature { id: FeatureId("feature/sim-music/daw-session-runtime"), why: "The DAW session row supplies the reusable session graph around the performance." }, Feature { id: FeatureId("feature/sim-music/synth-performance-workbench"), why: "The synth row turns that material into local or browser-backed sound." }, Specimen { id: SpecimenId("recipe/sim-music/crates/sim-lib-music-synth/01-basics/subtractive-preset"), why: "The preset recipe is the smallest synth example." }], doc_anchor: None })] [note "route/build-music-performance"] [section "route"])
  (primary [row Route(RouteRecord { id: RouteId("route/complete-exact-score-consonance"), title: "Complete an exact score with reversible consonance additions", audiences: ["user", "code", "framework"], steps: [Feature { id: FeatureId("feature/sim-music/exact-music-analysis-and-transform"), why: "The exact transform row owns identity-bearing Staff values and the generic additive staff apply/remove seam." }, Feature { id: FeatureId("feature/sim-music/exact-score-consonance"), why: "The evaluation row supplies exact sounding windows and separately inspectable named metrics." }, Feature { id: FeatureId("feature/sim-music/reversible-consonance-completion"), why: "The completion row composes typed additions, constraints, reports, content binding, changed windows, provenance, and exact inversion while delegating deterministic traversal, bounds, interrupts, and receipts to sim-lib-discrete-search." }, Specimen { id: SpecimenId("recipe/sim-music/crates/sim-lib-music-consonance/01-basics/additive-consonance-completion"), why: "The checked descriptor and paired Rust specimen show the bounded reversible completion contract." }], doc_anchor: None })] [note "route/complete-exact-score-consonance"] [section "route"])
  (primary [row Route(RouteRecord { id: RouteId("route/complete-serial-consonance"), title: "Complete a realized serial plan with bounded reversible additions", audiences: ["user", "code", "framework"], steps: [Feature { id: FeatureId("feature/sim-music/serial-practice"), why: "The serial row owns the immutable plan, stable event identities, strict realization, and the structural-versus-all-sounding reading boundary that the adapter must preserve." }, Feature { id: FeatureId("feature/sim-music/open-serial-adaptation"), why: "The adaptation row supplies the optional modal-projection evidence that the completion adapter can admit explicitly without pretending the result remains strict chromatic output." }, Feature { id: FeatureId("feature/sim-music/exact-score-consonance"), why: "The exact score row establishes the identity-bearing staff surface and exact sounding timeline that additive completion must preserve." }, Feature { id: FeatureId("feature/sim-music/reversible-consonance-completion"), why: "The reversible completion row defines the generic additive-search contract that the serial row narrows through serial-specific legality and post-completion ledgers." }, Feature { id: FeatureId("feature/sim-music/serial-consonance-completion"), why: "The serial completion row filters generic candidates through serial allowances, leaves the structural plan unchanged, delegates deterministic finite traversal, work/result bounds, cancellation, and honest receipts to sim-lib-discrete-search, and returns structural plus all-sounding ledgers beside the reversible patch result." }, Specimen { id: SpecimenId("recipe/sim-music/crates/sim-lib-music-serial/02-adaptation/serial-consonance-completion"), why: "The checked Rust scenario completes one realized row statement with a stated pitch-class addition, proves the structural ledger is unchanged, and records the added material only in the all-sounding ledger." }], doc_anchor: None })] [note "route/complete-serial-consonance"] [section "route"])
  (primary [row Route(RouteRecord { id: RouteId("route/compose-music-carpet"), title: "Compose and relatively encode a finite music carpet", audiences: ["user", "code", "framework"], steps: [Feature { id: FeatureId("feature/sim-music/exact-music-analysis-and-transform"), why: "The exact music row supplies canonical Music, rational time, audited conversions, and reusable transform chains; carpet addressing calls the shared discrete-rank crate rather than implementing rank locally." }, Feature { id: FeatureId("feature/sim-music/carpet-composition"), why: "The carpet row owns finite axes, sparse cells, explicit layout policy, shared mixed-radix addressing, algebraic layout operations, and relative pitch/time forms." }, Specimen { id: SpecimenId("spec-test/sim-music/crates/sim-lib-music-combinators/src/carpet_conformance"), why: "The checked algebraic fixtures prove mixed-radix rank parity, explicit boundary policy, rotations, reflections, slices, overlays, and transform-chain composition." }, Specimen { id: SpecimenId("spec-test/sim-music/crates/sim-lib-music-combinators/src/relative_conformance"), why: "The checked conversion fixtures prove exact retained-origin round trips and named losses for omitted origins and source structure." }], doc_anchor: None })] [note "route/compose-music-carpet"] [section "route"])
  (primary [row Route(RouteRecord { id: RouteId("route/compose-offline-realtime-audio"), title: "Compose one timbre as deterministic offline audio and a realtime DSP preview", audiences: ["user", "code", "framework"], steps: [Feature { id: FeatureId("feature/sim-music/pitch-and-sound-vocabulary"), why: "The sound vocabulary owns additive partials, envelopes, filters, Karplus-Strong, and compact FM timbres." }, Feature { id: FeatureId("feature/sim-music/synth-performance-workbench"), why: "The synth workbench owns oscillator, subtractive, DX7 FM, modular synth, offline-render, PCM16 WAV, and explicit Table/Dir recipe routing." }, Specimen { id: SpecimenId("recipe/sim-music/crates/sim-lib-music-synth/03-composition/offline-realtime-preview"), why: "The recipe maps every catalog need to an existing owner, renders offline through sound-render, previews through graph/DSP, and uses non-overwriting Table/Dir handles." }, Specimen { id: SpecimenId("spec-test/sim-music/crates/sim-lib-music-synth/src/tests/reuse"), why: "The paired conformance test decodes the recipe and checks its nine owner mappings, bounded callback policy, Table/Dir handles, and phase-43 conversion/dither deferral." }, Specimen { id: SpecimenId("spec-test/sim-music/crates/sim-lib-sound-render/src/tests"), why: "The renderer specimen proves additive, Karplus-Strong, and FM timbres produce finite deterministic offline PCM." }], doc_anchor: None })] [note "route/compose-offline-realtime-audio"] [section "route"])
  (primary [row Route(RouteRecord { id: RouteId("route/describe-declarative-harmony"), title: "Describe harmony palettes and rules as data", audiences: ["user", "code", "framework"], steps: [Feature { id: FeatureId("feature/sim-music/pitch-and-sound-vocabulary"), why: "The vocabulary row supplies existing chord symbols, exact pitches and ratios, pitch sets, scale maps, voicings, and named sonance models." }, Feature { id: FeatureId("feature/sim-music/declarative-harmony"), why: "The declarative row assembles those owners into codec-neutral palettes, template chains, hard rules, soft metrics, evidence, voicing changes, and render settings." }, Specimen { id: SpecimenId("spec-test/sim-music/crates/sim-lib-pitch-chord/src/harmony_conformance"), why: "The checked Lisp descriptors reproduce the catalog harmonizer and chord-cycle palette/filter chains without compiled policy." }], doc_anchor: None })] [note "route/describe-declarative-harmony"] [section "route"])
  (primary [row Route(RouteRecord { id: RouteId("route/evaluate-exact-score-consonance"), title: "Evaluate exact score consonance", audiences: ["user", "code", "framework"], steps: [Feature { id: FeatureId("feature/sim-music/exact-music-analysis-and-transform"), why: "The exact music row supplies canonical rational score time and identity-bearing Staff conversion." }, Feature { id: FeatureId("feature/sim-music/midi-notation-workflows"), why: "The MIDI row supplies overlap- and pedal-aware realization before MIDI window evaluation." }, Feature { id: FeatureId("feature/sim-music/pitch-and-sound-vocabulary"), why: "The vocabulary row owns the pitch, ratio, contextual sonance, psychoacoustic, and tuning models." }, Feature { id: FeatureId("feature/sim-music/exact-score-consonance"), why: "The consonance row composes those owners into multiplicity-preserving sounding windows and separate metric reports." }, Specimen { id: SpecimenId("recipe/sim-music/crates/sim-lib-music-consonance/01-basics/exact-score-consonance"), why: "The Lisp recipe shows an exact progression report with a retained doubling and no implicit aggregate." }], doc_anchor: None })] [note "route/evaluate-exact-score-consonance"] [section "route"])
  (primary [row Route(RouteRecord { id: RouteId("route/exchange-score-musicxml"), title: "Import and export a bounded MusicXML score", audiences: ["user", "code", "framework"], steps: [Feature { id: FeatureId("feature/sim-music/midi-notation-workflows"), why: "The notation row owns the bounded MusicXML profile, stable exchange ids, loss reports, and one runtime import callable." }, Feature { id: FeatureId("feature/sim-music/exact-music-analysis-and-transform"), why: "The exact score row supplies canonical rational Score semantics and the existing SIM expression/read-construct form." }, Specimen { id: SpecimenId("recipe/sim-music/crates/sim-lib-music-notation/01-basics/musicxml-import"), why: "The notation recipe shows the bounded runtime call and profile limits." }, Specimen { id: SpecimenId("spec-test/sim-music/crates/sim-lib-music-notation/src/tests"), why: "The checked fixture proves DTD rejection, bounds, ids, losses, and LilyPond/MusicXML/SIM semantic round trips." }], doc_anchor: None })] [note "route/exchange-score-musicxml"] [section "route"])
  (primary [row Route(RouteRecord { id: RouteId("route/generate-counterpoint"), title: "Generate bounded reversible counterpoint", audiences: ["user", "code", "framework"], steps: [Feature { id: FeatureId("feature/sim-music/exact-score-consonance"), why: "The consonance row owns the content-bound additive patch and exact inverse that preserve the fixed cantus staff." }, Feature { id: FeatureId("feature/sim-music/music-counterpoint"), why: "The counterpoint row compiles rule data to finite CSP variables/domains, delegates traversal and receipts to discrete-search, propagates musical constraints, selects diverse legal results, and rechecks each result through the existing analyzer." }, Specimen { id: SpecimenId("recipe/sim-music/crates/sim-lib-music-counterpoint/01-basics/bounded-generation"), why: "The checked Lisp specimen generates two second-species voices under explicit work, result, frontier-default, and seed evidence." }], doc_anchor: None })] [note "route/generate-counterpoint"] [section "route"])
  (primary [row Route(RouteRecord { id: RouteId("route/grow-bounded-music-catalog"), title: "Grow and inspect a bounded recursive music catalog", audiences: ["user", "code", "framework"], steps: [Feature { id: FeatureId("feature/sim-music/exact-music-analysis-and-transform"), why: "The exact transform row supplies first-class partial pitch maps and scale-aware music transformations." }, Feature { id: FeatureId("feature/sim-music/bounded-rewrite-catalogs"), why: "The rewrite row owns typed musical alphabets, productive context rules, scale-following state data, finite progression-tree topology, and derivation evidence while delegating ordinals and traversal to shared discrete rank/search." }, Specimen { id: SpecimenId("spec-test/sim-music/crates/sim-lib-music-combinators/src/rewrite_conformance"), why: "The checked conformance module proves typed contextual derivation, preflight rejection, rank round trips, bounded filtered search, scale-map materialization, and stable receipts." }], doc_anchor: None })] [note "route/grow-bounded-music-catalog"] [section "route"])
  (primary [row Route(RouteRecord { id: RouteId("route/harmonize-melody"), title: "Harmonize a melody under explicit rules and bounds", audiences: ["user", "code", "framework"], steps: [Feature { id: FeatureId("feature/sim-music/pitch-and-sound-vocabulary"), why: "The vocabulary row supplies melody pitch sets, chord templates, scales, registers, voice-leading, and named sonance models." }, Feature { id: FeatureId("feature/sim-music/declarative-harmony"), why: "The declarative row supplies the palette plus separate hard legality and weighted score lanes." }, Feature { id: FeatureId("feature/sim-music/bounded-harmonization"), why: "The harmonization row adapts the shared musical problem to exhaustive, factored, certified layered-DP, and beam strategies." }, Specimen { id: SpecimenId("recipe/sim-music/crates/sim-lib-music-combinators/01-basics/bounded-harmonization"), why: "The Lisp recipe shows the public layered-DP call with explicit work, result, and seed bounds." }], doc_anchor: None })] [note "route/harmonize-melody"] [section "route"])
  (primary [row Route(RouteRecord { id: RouteId("route/import-export-smf"), title: "Import and export SMF", audiences: ["user", "code", "framework"], steps: [Feature { id: FeatureId("feature/sim-music/midi-notation-workflows"), why: "The MIDI row owns MIDI event, SMF, stream, and notation interchange." }, Feature { id: FeatureId("feature/sim-music/exact-music-analysis-and-transform"), why: "The exact music row owns the lift and lower adapters between MIDI tracks and music descriptors." }, Specimen { id: SpecimenId("recipe/sim-music/crates/sim-lib-midi-smf/01-basics/file-metadata"), why: "The SMF metadata recipe proves the file owner." }, Specimen { id: SpecimenId("recipe/sim-music/crates/sim-lib-music-lift/01-basics/from-midi-track"), why: "The lift recipe imports MIDI track material into music descriptors." }, Specimen { id: SpecimenId("recipe/sim-music/crates/sim-lib-music-lower/01-basics/to-midi-track"), why: "The lower recipe exports music descriptors back to MIDI track material." }], doc_anchor: None })] [note "route/import-export-smf"] [section "route"])
  (primary [row Route(RouteRecord { id: RouteId("route/lift-audio-features"), title: "Analyze current audio lift into music descriptors", audiences: ["user", "code", "framework"], steps: [Feature { id: FeatureId("feature/sim-music/audio-lift-and-render"), why: "The audio row owns PCM feature lift, spectral summaries, and offline render evidence for audio analysis." }, Feature { id: FeatureId("feature/sim-music/exact-music-analysis-and-transform"), why: "The music analysis row owns pitch histograms and exact object descriptors that consume lifted musical material." }, Specimen { id: SpecimenId("recipe/sim-music/crates/sim-lib-sound-audio-lift/01-basics/onset-beat-harmony"), why: "The checked Lisp analysis call selects onsets, beats, MFCC, chroma, key, and chords under explicit varying-tempo, posterior/HMM, work, result, and seed policy; its generated click/chord fixture proves timing and labels." }, Specimen { id: SpecimenId("recipe/sim-music/crates/sim-lib-music-analysis/01-basics/pitch-histogram"), why: "The pitch-histogram recipe is the current exact music analysis specimen." }], doc_anchor: None })] [note "route/lift-audio-features"] [section "route"])
  (primary [row Route(RouteRecord { id: RouteId("route/plan-serial-practice"), title: "Freeze and realize a serial plan with immutable provenance and chord-safe partial order", audiences: ["user", "code", "framework"], steps: [Feature { id: FeatureId("feature/sim-music/serial-series-calculus"), why: "The generic serial layer owns stable finite ordered-symbol identity and aggregate validation without assuming pitch or score order." }, Feature { id: FeatureId("feature/sim-music/twelve-tone-row-theory"), why: "The pitch-serial layer owns strict row values and operation-bearing RowForm provenance for each row instance." }, Feature { id: FeatureId("feature/sim-music/serial-practice"), why: "The music-serial layer freezes row instances, stable event ids, ordinal references, role/origin provenance, explicit parents, simultaneous groups, and precedence into one immutable validated plan, then realizes strict statements with explicit register, duration, dynamics, rests, ties, and canonical music-core rendering." }, Specimen { id: SpecimenId("recipe/sim-music/crates/sim-lib-music-serial/01-basics/immutable-plan"), why: "The checked Rust scenario proves that one row can span multiple voices while equal-onset material stays grouped without a fabricated chord order." }, Specimen { id: SpecimenId("recipe/sim-music/crates/sim-lib-music-serial/01-basics/strict-row-realization"), why: "The checked Rust scenario realizes a strict row statement with a chord, rest, tie, and equal-pitch simultaneous notes while preserving plan, event, voice, and ordinal identity through the piano roll." }], doc_anchor: None })] [note "route/plan-serial-practice"] [section "route"])
  (primary [row Route(RouteRecord { id: RouteId("route/realize-serial-spine"), title: "Adapt an immutable serial plan onto a modal or caller-defined spine without hiding aggregate loss", audiences: ["user", "code", "framework"], steps: [Feature { id: FeatureId("feature/sim-music/serial-practice"), why: "The serial owner keeps the immutable plan, stable event identities, row-form provenance, explicit strict specs, and strict chromatic baseline intact before any adaptation occurs." }, Feature { id: FeatureId("feature/sim-music/pitch-and-sound-vocabulary"), why: "The pitch vocabulary row owns named scales, caller-defined player scales, and contextual sonance models reused by the adaptation report." }, Feature { id: FeatureId("feature/sim-music/exact-music-analysis-and-transform"), why: "The exact transform row owns the first-class partial pitch-map policy that modal landing reuses instead of inventing another remap surface." }, Feature { id: FeatureId("feature/sim-music/open-serial-adaptation"), why: "The open adaptation row owns landed modal realization, aggregate-relaxation receipts, and the independent spine, pitch, ordinal, and sonance report facets." }, Specimen { id: SpecimenId("recipe/sim-music/crates/sim-lib-music-serial/02-adaptation/third-party-adaptation"), why: "The checked external-style scenario registers a seven-symbol non-pitch series, a custom practice rule, and a custom realizer through public APIs only, then proves the Lisp validation hook and realizer registry both fail closed on unknown components." }, Specimen { id: SpecimenId("recipe/sim-music/crates/sim-lib-music-serial/02-adaptation/modal-spine"), why: "The checked Rust scenario realizes the same immutable plan through C Dorian, C Lydian, and a caller-defined scale, proves plan equality with differing sounding pitches, and inspects the spine report without claiming strict twelve-tone output." }], doc_anchor: None })] [note "route/realize-serial-spine"] [section "route"])
  (primary [row Route(RouteRecord { id: RouteId("route/run-music-algorithm-foundry"), title: "Assemble a replaceable end-to-end music algorithm application from plan data", audiences: ["user", "code", "framework"], steps: [Feature { id: FeatureId("feature/sim-music/midi-notation-workflows"), why: "The MIDI row owns bounded SMF decoding, exact realization policy, and canonical export." }, Feature { id: FeatureId("feature/sim-music/audio-lift-and-render"), why: "The audio row owns the optional audio-input analysis adapter and finite offline rendering inputs." }, Feature { id: FeatureId("feature/sim-music/algorithm-foundry"), why: "The foundry row owns data-plan validation, open stage registration, Shape ranking, result checks, trace, Table/Dir boundaries, and realize-target preview delegation." }, Feature { id: FeatureId("feature/sim-music/bounded-harmonization"), why: "The harmony row supplies the selected layered-DP and alternate exhaustive implementations under the same rules and bounds." }, Feature { id: FeatureId("feature/sim-music/music-counterpoint"), why: "The counterpoint row supplies inspectable species rules, legal transforms, and bounded generation/analysis." }, Specimen { id: SpecimenId("recipe/sim-music/music-algorithm-foundry"), why: "The runnable fixture checks every intermediate summary, exact SMF/WAV frame digests, data-only alternate selection, and the missing optional-stage diagnostic." }], doc_anchor: None })] [note "route/run-music-algorithm-foundry"] [section "route"])
  (primary [row Route(RouteRecord { id: RouteId("route/run-serial-music-workbench"), title: "Run a serial music workbench", audiences: ["user", "code", "framework"], steps: [Feature { id: FeatureId("feature/sim-music/twelve-tone-row-theory"), why: "The pitch-serial row owns the strict source row, family/matrix inspection, and partition evidence that the workbench freezes before realization." }, Feature { id: FeatureId("feature/sim-music/serial-practice"), why: "The serial practice row owns the immutable plan, strict realization context, simultaneous grouping, referential evidence, counter-voice techniques, arrays/time points, and integral parameter surfaces that the workbench assembles into one inspectable source." }, Feature { id: FeatureId("feature/sim-music/open-serial-adaptation"), why: "The adaptation row owns the registry-selected modal realizer and the spine report proving aggregate relaxation explicitly rather than silently mutating the source plan." }, Feature { id: FeatureId("feature/sim-music/serial-consonance-completion"), why: "The completion row owns the reversible additive patch, structural-versus-all-sounding ledger audit, and exact inverse proof after completion." }, Feature { id: FeatureId("feature/sim-music/midi-notation-workflows"), why: "The MIDI and notation row owns SMF export, LilyPond projection, and the exact score lowering surface used for audition." }, Feature { id: FeatureId("feature/sim-music/serial-music-workbench"), why: "The workbench row composes those replaceable owners into one executable recipe with fixture-manifest coverage and a hard no-copyrighted-score rule." }, Specimen { id: SpecimenId("recipe/sim-music/serial-workbench/01-end-to-end/row-to-audition"), why: "The checked runnable recipe validates the fixture manifest, runs strict plus modal realization, completes and undoes one additive patch, audits the ledgers, exports MIDI plus LilyPond notation, and lowers the audition score end to end." }], doc_anchor: None })] [note "route/run-serial-music-workbench"] [section "route"])
  (primary [row Route(RouteRecord { id: RouteId("route/transform-and-normalize-audio"), title: "Stretch, pitch, measure, normalize, and lower offline PCM", audiences: ["user", "code", "framework"], steps: [Feature { id: FeatureId("feature/sim-music/audio-lift-and-render"), why: "The audio-lift row supplies bounded phase-preserving STFT frames and COLA evidence while delegating FFT conventions and phase unwrapping to numbers-signal." }, Feature { id: FeatureId("feature/sim-music/offline-audio-transform-and-loudness"), why: "The offline transform row owns phase-vocoder policy, standards-named loudness/true-peak reports, visible normalization gain, and bounded PCM16 conversion." }, Specimen { id: SpecimenId("spec-test/sim-music/crates/sim-lib-sound-render/src/tests"), why: "The renderer specimen proves duration/pitch invariants, transient resets, EBU reference loudness, intersample true peak, and visible normalization gain." }, Specimen { id: SpecimenId("spec-test/sim-music/crates/sim-lib-stream-file/src/tests"), why: "The interchange specimen proves bounded channel mapping, seeded dither determinism, clipping reports, and routing through canonical WAV encoding." }], doc_anchor: None })] [note "route/transform-and-normalize-audio"] [section "route"])
  (primary [row Route(RouteRecord { id: RouteId("route/transform-exact-music"), title: "Transform exact music", audiences: ["user", "code", "framework"], steps: [Feature { id: FeatureId("feature/sim-music/exact-music-analysis-and-transform"), why: "The exact music row owns loss-audited score conversion, identity-bearing progression algebra, certified voice-leading paths, partial pitch-map policy composition, lift/lower adapters, and notation descriptors." }, Feature { id: FeatureId("feature/sim-music/pitch-and-sound-vocabulary"), why: "The pitch row supplies deterministic chord voicing palettes plus the pitch, scale, and tuning vocabulary used by exact transforms." }, Specimen { id: SpecimenId("spec-test/sim-music/crates/sim-lib-music-transform/src/tests/exact"), why: "The checked exact-transform fixture compares greedy movement with a certified optimum over exact score identities." }], doc_anchor: None })] [note "route/transform-exact-music"] [section "route"])
  (primary [row Route(RouteRecord { id: RouteId("route/transform-musical-series"), title: "Validate a finite musical series before applying total symbolic transforms", audiences: ["user", "code", "framework"], steps: [Feature { id: FeatureId("feature/sim-music/serial-series-calculus"), why: "The serial row owns stable finite alphabet identity, symbol-bearing order, aggregate-rule data, typed failures, validation ledgers, validated ordinal and symbol bijections, total transform composition, algebra certificates, the Shape adapter, and the Lisp validation call while delegating generic permutation rank to sim-discrete." }, Specimen { id: SpecimenId("recipe/sim-music/crates/sim-lib-serial-core/01-basics/custom-alphabet"), why: "The checked Lisp recipe validates and ranks an exhaustive five-symbol gesture alphabet, proving that the reusable calculus has no pitch dependency." }, Specimen { id: SpecimenId("recipe/sim-music/crates/sim-lib-serial-core/01-basics/certified-transforms"), why: "The checked Rust recipe composes retrograde and rotation, applies the returned inverse, and proves exact source recovery with aggregate-preservation evidence." }], doc_anchor: None })] [note "route/transform-musical-series"] [section "route"])
